  "content": "<div class=\"c-rich c-rich-left\"><h2 class=\"c-rich c-rich-h2\">\r</h2><h1 class=\"c-rich c-rich-h1\">Gaming\r</h1><ul class=\"c-rich c-rich-ul\"><li class=\"c-rich c-rich-li\"><a class=\"c-rich c-rich-link\" href=\"https://dor.sd.gov/businesses/gaming/#statistics\">Gaming Statistical Information</a></li></ul><p class=\"c-rich c-rich-p\"></p><h1 class=\"c-rich c-rich-h1\">Motor Vehicle</h1><ul class=\"c-rich c-rich-ul\"><li class=\"c-rich c-rich-li\"><a class=\"c-rich c-rich-link\" href=\"https://dor.sd.gov/media/katnvb1b/sddor_titles-registrations-historical-cy2025.pdf\">Historical Title and Registration Statistics</a></li><li class=\"c-rich c-rich-li\"><a class=\"c-rich c-rich-link\" href=\"https://dor.sd.gov/media/ybupqg3q/sddor_titles-registrations-historical-septembercy26_10126.pdf\">CY26 Title and Registration Monthly Statistics</a></li><li class=\"c-rich c-rich-li\"><a class=\"c-rich c-rich-link\" href=\"https://dor.sd.gov/media/p0obcg10/sddor_titles-registrations-historical-cy25_1625.pdf\">CY25 Title and Registration Monthly Statistics</a></li><li class=\"c-rich c-rich-li\"><a class=\"c-rich c-rich-link\" href=\"https://dor.sd.gov/media/uf5ntwzr/sddor_titles-registrations-historical-decembercy24_1325.pdf\">CY24 Title and Registration Monthly Statistics</a></li><li class=\"c-rich c-rich-li\"><a class=\"c-rich c-rich-link\" href=\"https://dor.sd.gov/media/nb4jgev2/sddor_titles-registrations-historical-mnthcy2023_1-2-24.pdf\">CY23 Title and Registration Monthly Statistics</a></li><li class=\"c-rich c-rich-li\"><a class=\"c-rich c-rich-link\" href=\"https://dor.sd.gov/media/cw3f0nnr/sddor_titles-registrations-historical-mnthcy22.pdf\">CY22 Title and Registration Monthly Statistics</a></li><li class=\"c-rich c-rich-li\"><a class=\"c-rich c-rich-link\" href=\"https://dor.sd.gov/media/y0llotxx/sddor_titles-registrations-historical-mnthcy21.pdf\">CY21 Title and Registration Monthly Statistics</a></li><li class=\"c-rich c-rich-li\"><a class=\"c-rich c-